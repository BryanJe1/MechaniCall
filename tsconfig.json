{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",               // ✅ Recommended for React 17+
    "strict": true,
    "allowJs": true,                  // ✅ Allow .js files if needed
    "checkJs": false,                 // ✅ Skip type checking in .js
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "app",
    "components",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
